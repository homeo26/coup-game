rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      // Admin edits anything; anonymous customers may ONLY bump the
      // engagement counters (views / cartAdds), by at most +5 per write
      // and never downward — nothing else on the doc can change.
      allow update: if request.auth != null || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views', 'cartAdds'])
        && request.resource.data.get('views', 0) is int
        && request.resource.data.get('cartAdds', 0) is int
        && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
        && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 5
        && request.resource.data.get('cartAdds', 0) >= resource.data.get('cartAdds', 0)
        && request.resource.data.get('cartAdds', 0) <= resource.data.get('cartAdds', 0) + 5
      );
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pushTokens/{tokenId} {
      // Customers register/unregister their own push token (doc id = token).
      // No public read — only the authenticated admin can list tokens.
      allow read: if request.auth != null;
      allow create, update, delete: if request.resource == null || request.resource.id == tokenId;
    }
    match /coup_rooms/{code} {
      // Coup game rooms (coup-game app). Anonymous multiplayer: anyone
      // with the 4-letter code can read and move. Structure + size are
      // validated to keep abuse bounded; rooms are transient.
      allow read: if true;
      allow create: if code.size() == 4
        && request.resource.data.keys().hasAll(['hostId', 'status', 'roster'])
        && request.resource.data.status in ['lobby', 'playing']
        && request.resource.data.roster is list
        && request.resource.data.roster.size() <= 6;
      allow update: if request.resource.data.status in ['lobby', 'playing']
        && request.resource.data.roster is list
        && request.resource.data.roster.size() <= 6
        && (request.resource.data.get('gameJson', null) == null
            || request.resource.data.gameJson.size() < 100000);
      allow delete: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coup game rooms — the only collection in this project.
    // Anonymous multiplayer: anyone with the 4-letter code can read and
    // move. Structure + size are validated to keep abuse bounded; rooms
    // are transient (clients delete them — last leaver + 24h sweep).
    match /coup_rooms/{code} {
      allow read: if true;
      allow create: if code.size() == 4
        && request.resource.data.keys().hasAll(['hostId', 'status', 'roster'])
        && request.resource.data.status in ['lobby', 'playing']
        && request.resource.data.roster is list
        && request.resource.data.roster.size() <= 6;
      allow update: if request.resource.data.status in ['lobby', 'playing']
        && request.resource.data.roster is list
        && request.resource.data.roster.size() <= 6
        && (request.resource.data.get('gameJson', null) == null
            || request.resource.data.gameJson.size() < 100000);
      allow delete: if true;
    }
    // Everything else: denied by default (no other collections exist).
  }
}
